{
  "name": "@network-decode/node-guard",
  "version": "0.2.0-alpha.7",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smccann01/node-guard-free.git"
  },
  "homepage": "https://github.com/Smccann01/node-guard-free#readme",
  "bugs": "https://github.com/Smccann01/node-guard-free/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "DEVELOPER_SETUP.md",
    "NEXT_ROUTE_GUIDE.md",
    "LOCAL_API.md",
    "index.mjs",
    "index.d.ts",
    "guard-core.mjs",
    "express.mjs",
    "express.d.ts",
    "policy.mjs",
    "policy.d.ts",
    "policy-runtime.mjs",
    "policy-runtime.d.ts",
    "trusted-source.mjs",
    "trusted-source.d.ts",
    "next-route.mjs",
    "next-route.d.ts",
    "local-api.mjs",
    "local-api.d.ts",
    "bin/nodeguard.mjs",
    "examples/auth-policy.json",
    "examples/auth-observations.json",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./express": {
      "types": "./express.d.ts",
      "default": "./express.mjs"
    },
    "./policy": {
      "types": "./policy.d.ts",
      "default": "./policy.mjs"
    },
    "./policy-runtime": {
      "types": "./policy-runtime.d.ts",
      "default": "./policy-runtime.mjs"
    },
    "./trusted-source": {
      "types": "./trusted-source.d.ts",
      "default": "./trusted-source.mjs"
    },
    "./next-route": {
      "types": "./next-route.d.ts",
      "default": "./next-route.mjs"
    },
    "./local-api": {
      "types": "./local-api.d.ts",
      "default": "./local-api.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nodeguard": "bin/nodeguard.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM scripts/types-smoke.mts",
    "smoke:package": "node scripts/clean-install-smoke.mjs",
    "smoke:next": "node scripts/next-clean-app-smoke.mjs"
  },
  "devDependencies": {
    "express": "^5.3.0",
    "typescript": "5.9.3"
  }
}
